{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/handler?__bank_soal_path=:path*"
    }
  ],
  "functions": {
    "api/handler.js": {
      "includeFiles": "server/schema.sql"
    }
  }
}
